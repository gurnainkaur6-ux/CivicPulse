# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id

# Appwrite Database IDs
NEXT_PUBLIC_APPWRITE_DOCUMENTS_DB_ID=your_documents_db_id
NEXT_PUBLIC_APPWRITE_ISSUES_COLLECTION_ID=your_issues_collection_id

# Appwrite Storage
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=your_storage_bucket_id

# Server-side Appwrite API Key (for Functions)
APPWRITE_API_KEY=your_api_key

# PostgreSQL (Managed by Appwrite)
POSTGRES_HOST=db-xxxxx.region.appwrite.center
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSL=true

# MySQL (Managed by Appwrite)
MYSQL_HOST=db-yyyyy.region.appwrite.center
MYSQL_PORT=3306
MYSQL_DB=civicpulse_analytics
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_SSL=true

# Map Configuration
NEXT_PUBLIC_MAP_DEFAULT_LAT=30.9010
NEXT_PUBLIC_MAP_DEFAULT_LNG=75.8573
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13
