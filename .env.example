# Appwrite project
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id

# Appwrite TablesDB (database + table IDs from the console)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
NEXT_PUBLIC_APPWRITE_ISSUES_TABLE_ID=your_issues_table_id
NEXT_PUBLIC_APPWRITE_UPVOTES_TABLE_ID=your_upvotes_table_id
NEXT_PUBLIC_APPWRITE_STATUS_EVENTS_TABLE_ID=your_status_events_table_id

# Appwrite Storage bucket for issue photos
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=photos

# Server-side API key. Scopes: databases/tables/columns/rows read+write,
# files read+write, users read.
APPWRITE_API_KEY=your_api_key

# Comma separated emails that get admin access
# (users with the `admin` label always have access too)
ADMIN_EMAILS=

# Default map centre (Ludhiana)
NEXT_PUBLIC_MAP_DEFAULT_LAT=30.9010
NEXT_PUBLIC_MAP_DEFAULT_LNG=75.8573
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13
